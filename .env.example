# ==============================================================
# AI Cyber Attack Response Coordinator - Environment Configuration
# Copy this file to `.env` and fill in real values before deploying.
# ==============================================================

# --- General ---
APP_NAME=AI Cyber Attack Response Coordinator
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM Provider: "openai" | "ollama" | "none" ---
# "none" runs the entire pipeline using heuristic rules only (no API key needed).
LLM_PROVIDER=none

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.5

# --- Alerting ---
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=soc-alerts@example.com
ALERT_EMAIL_TO=soc-team@example.com
SLACK_WEBHOOK_URL=

# --- Safety ---
# When true (default), response/alert tools simulate actions instead of
# performing real network/email side effects. Set to false only in a
# fully-authorized production deployment.
DRY_RUN=true

# --- Risk thresholds (0-100 risk score) ---
CRITICAL_RISK_THRESHOLD=85
HIGH_RISK_THRESHOLD=65
MEDIUM_RISK_THRESHOLD=40
